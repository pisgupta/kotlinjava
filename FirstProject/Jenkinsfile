pipeline {
    agent any

    stages {

        stage('Build') {
            steps {
                echo 'Starting Gradle build and JaCoCo coverage...'

                dir('FirstProject') {
                    sh '''
                        echo "Current directory:"
                        pwd

                        echo "Project files:"
                        ls -la

                        chmod +x gradlew

                        docker run --rm \
                            -v "$(pwd)":/workspace \
                            -v /var/lib/jenkins/.gradle:/home/gradle/.gradle \
                            -e GRADLE_USER_HOME=/home/gradle/.gradle \
                            -w /workspace \
                            android-build:latest \
                            ./gradlew clean test jacocoTestReport
                    '''
                }
            }
        }

        stage('Archive JAR') {
            steps {
                archiveArtifacts artifacts: 'FirstProject/build/libs/*.jar',
                                 fingerprint: true
            }
        }
    }

    post {

        always {
            echo 'Publishing JUnit and JaCoCo reports...'

            junit 'FirstProject/build/test-results/test/*.xml'

            jacoco(
                execPattern: 'FirstProject/build/jacoco/test.exec',
                classPattern: 'FirstProject/build/classes/java/main',
                sourcePattern: 'FirstProject/src/main/java'
            )

            echo 'Pipeline execution completed.'
        }

        success {
            echo 'Build completed successfully!'
        }

        failure {
            echo 'Build failed!'
        }
    }
}

